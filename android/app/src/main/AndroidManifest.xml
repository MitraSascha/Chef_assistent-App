<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Der Dienst ist nur ueber Tailscale erreichbar; INTERNET deckt auch das VPN-Interface ab. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Fuer POST /v1/sprache: Diktat und Freihandmodus. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Grosse Videos und Dokumente laufen als Vordergrunddienst hoch: ohne den
         beendet Android einen Hintergrundauftrag nach etwa 10 Minuten, und ein
         1-GB-Video ueber Mobilfunk faenge immer wieder von vorn an. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Gemeinsam fuer Buero- und Monteur-App. Application-Klasse, Activities und
         Dienste stehen in src/buero bzw. src/monteur. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/datenuebertragung"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChefAssistent">

        <!-- Vordergrunddienst von WorkManager fuer den VersandArbeiter (Typ seit Android 14 Pflicht). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Gibt heruntergeladene Dateien aus GET /v1/datei an andere Apps weiter. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.dateien"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/dateipfade" />
        </provider>
    </application>

</manifest>
